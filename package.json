{
  "name": "nomercy-cast-receiver",
  "version": "1.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "NoMercy Cast Web Receiver — full Leanback web app served at cast.nomercy.tv for non-APK Cast targets",
  "scripts": {
    "dev": "vite --host --force",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .ts,.vue --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\""
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "@nomercy-entertainment/nomercy-music-player": "0.2.15",
    "@nomercy-entertainment/nomercy-video-player": "0.6.10",
    "@tanstack/vue-query": "^5.62.0",
    "hls.js": "^1.6.15",
    "vue": "^3.5.13",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/chromecast-caf-receiver": "^6.0.25",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.0",
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^2.1.0"
  },
  "resolutions": {
    "immutable": ">=5.1.5",
    "rollup": ">=4.59.0"
  },
  "packageManager": "yarn@4.13.0"
}
